# ============================================================
# WATCH-DM .gitignore
# Protects PHI / patient data from ever entering version control.
# ============================================================

# --- Patient data (CRITICAL — never commit) ---
data/**
!data/README.md
!data/.gitkeep
!data/schema.md
!data/synthetic/
*.csv
*.xlsx
*.xls
*.dta
*.sav
*.parquet
*.feather
*.pkl
*.pickle
*.sqlite
*.db

# Allow small reference/template CSVs explicitly:
!docs/**/*.csv
!**/template_*.csv

# --- Results that may contain PHI ---
statistical-analysis/results/*
!statistical-analysis/results/.gitkeep
!statistical-analysis/results/README.md

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.conda/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints
.jupyter/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Environment variables / secrets ---
.env
.env.local
*.key
*.pem
credentials.json

# --- Logs ---
*.log
logs/

# --- OS ---
.DS_Store
.Trash-*
ehthumbs.db
Desktop.ini

# --- LaTeX (if docs use it) ---
*.aux
*.bbl
*.blg
*.synctex.gz
